{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsOrigins": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=cheater_watcher;Username=postgres;Password={POSTGRES_PASSWORD}"
  },
  "Jwt": {
    "Issuer": "CheaterWatcher.Api",
    "Audience": "CheaterWatcher.Client",
    "SecretKey": "",
    "AccessTokenMinutes": 60
  },
  "Auth": {
    "FrontendBaseUrl": "http://localhost:3000",
    "ApiBaseUrl": "http://localhost:5089"
  },
  "Storage": {
    "DemosPath": "demos",
    "MaxUploadMb": 500
  },
  "Leetify": {
    "BaseUrl": "https://api-public.cs-prod.leetify.com",
    "ApiKey": "",
    "CacheHours": 24
  },
  "Suspicion": {
    "Threshold": 70,
    "PreaimBelowDeg": 7,
    "PreaimWeight": 25,
    "ReactionTimeBelowMs": 250,
    "ReactionTimeWeight": 20,
    "HeadshotAccuracyAbovePct": 45,
    "HeadshotAccuracyWeight": 25,
    "SprayAccuracyAbovePct": 55,
    "SprayAccuracyWeight": 15,
    "CounterStrafingAbovePct": 96,
    "CounterStrafingWeight": 10,
    "PlatformBanWeight": 20
  },
  "Steam": {
    "WebApiKey": "",
    "PollingIntervalSeconds": 60
  }
}
