# Template copied to `.env` on first run by start.ps1 / start.sh (with a random
# POSTGRES_PASSWORD). You can also copy it yourself and fill in your values.
# Then run: docker compose up --build -d

# Required: password for the PostgreSQL instance (used by both db and backend).
POSTGRES_PASSWORD=change-me

# Optional: restrict which browser origins may call the API. "*" allows any origin.
CORS_ORIGINS=*

# Optional: Steam Web API key. Leave empty to disable Steam features.
# Enables persona name/avatar enrichment for linked accounts AND VAC ban checks
# for players you flag as Cheating/Suspicious. Get one at
# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# Path to your local CS2 replays folder, bind-mounted (read-only) into the
# backend at /app/replays-root. It can be set here manually OR from the app on
# first run: the app writes this same variable back to .env and then shows a
# "Docker restart required" notice. Run `docker compose up -d` once so the
# container mounts the new folder, then reload the page. Point it at e.g.:
#   "C:\Program Files (x86)\Steam\steamapps\common\Counter-Strike Global Offensive\game\csgo\replays"
# NOTE: On Windows with Docker Desktop, quote the path (double quotes) inside .env.
STEAM_REPLAYS_ROOT=./replays

# Optional: host ports exposed by docker-compose.
BACKEND_PORT=5089
FRONTEND_PORT=3000