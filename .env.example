# Copy this file to `.env` and fill in your values, then run: docker compose up --build -d

# Required: password for the PostgreSQL instance (used by both db and backend).
POSTGRES_PASSWORD=change-me

# Optional: restrict which browser origins may call the API. "*" allows any origin.
CORS_ORIGINS=*

# Optional: Steam Web API key. Leave empty to disable Steam features
# (player summaries, share-code match history). Get one at
# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# Optional: how often (seconds) to poll Steam for new share codes.
STEAM_POLLING_INTERVAL_SECONDS=60

# Optional: host ports exposed by docker-compose.
BACKEND_PORT=5089
FRONTEND_PORT=3000
